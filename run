#!/bin/sh
set -e

START_TIME=$(date +%s)

# Read version and app id without requiring node
CURRENT_VERSION=$(cat .version)
CURRENT_PACKAGE=$(cat .package)
VERSION="$CURRENT_VERSION"
APP_ID="$CURRENT_PACKAGE"

rm -rf logs && mkdir logs

elapsed() {
  echo $(( $(date +%s) - START_TIME ))
}

read_json_value() {
  FILE="$1"
  PATH_EXPR="$2"
  node -e 'const fs=require("fs"); const file=process.argv[1]; const pathExpr=process.argv[2].split("."); const json=JSON.parse(fs.readFileSync(file, "utf8")); let value=json; for (const key of pathExpr) value=value[key]; process.stdout.write(String(value));' "$FILE" "$PATH_EXPR"
}

write_json_file() {
  FILE="$1"
  SHIFT="$2"
  node -e 'const fs=require("fs"); const file=process.argv[1]; const shift=process.argv[2]; const json=JSON.parse(fs.readFileSync(file, "utf8")); const parts=shift.split("\n"); for (const part of parts) { const [pathExpr, rawValue] = part.split("="); const keys=pathExpr.split("."); let target=json; for (let i=0; i<keys.length-1; i++) target=target[keys[i]]; const key=keys[keys.length-1]; target[key] = /^\d+$/.test(rawValue) ? Number(rawValue) : rawValue; } fs.writeFileSync(file, JSON.stringify(json, null, "\t") + "\n");' "$FILE" "$SHIFT"
}

write_text_file() {
  FILE="$1"
  VALUE="$2"
  printf '%s\n' "$VALUE" > "$FILE"
}

replace_text_in_file() {
  FILE="$1"
  PATTERN="$2"
  REPLACEMENT="$3"
  node -e 'const fs=require("fs"); const file=process.argv[1]; const pattern=process.argv[2]; const replacement=process.argv[3]; const content=fs.readFileSync(file, "utf8"); fs.writeFileSync(file, content.replace(new RegExp(pattern, "gm"), replacement));' "$FILE" "$PATTERN" "$REPLACEMENT"
}

version_code_from_version() {
    CURRENT="$1"
    node -e 'const current=process.argv[1]; const parts=current.split(".").map(Number); if (parts.length !== 3 || parts.some(Number.isNaN) || parts.some(part => part < 0 || part > 99)) process.exit(1); const code = (parts[0] * 10000) + (parts[1] * 100) + parts[2]; process.stdout.write(String(code));' "$CURRENT"
}

validate_state() {
    CANONICAL_VERSION=$(cat .version)
    CANONICAL_PACKAGE=$(cat .package)
    APP_VERSION=$(read_json_value app.json expo.version)
    APP_PACKAGE=$(read_json_value app.json expo.android.package)
    PACKAGE_VERSION=$(read_json_value package.json version)
    APP_VERSION_CODE=$(read_json_value app.json expo.android.versionCode)
    EXPECTED_VERSION_CODE=$(version_code_from_version "$CANONICAL_VERSION")
    RELEASE_APP_ID_SOURCE=$(grep -E 'app_id=\$\(cat \.package\)' .github/workflows/release.yml | head -1 || true)
  GENERATED_VERSION=$(grep -E '^const VERSION = ' src/constants/version.ts | head -1 | sed 's/^const VERSION = "\(.*\)";$/\1/')

    if [ "$CANONICAL_VERSION" != "$APP_VERSION" ]; then
      echo "Version mismatch: .version=$CANONICAL_VERSION but app.json expo.version=$APP_VERSION"
      exit 1
    fi

    if [ "$CANONICAL_VERSION" != "$PACKAGE_VERSION" ]; then
      echo "Version mismatch: .version=$CANONICAL_VERSION but package.json version=$PACKAGE_VERSION"
      exit 1
    fi

    if [ "$APP_PACKAGE" != "$CANONICAL_PACKAGE" ]; then
      echo "Package mismatch: .package=$CANONICAL_PACKAGE but app.json expo.android.package=$APP_PACKAGE"
      exit 1
    fi

    if [ -z "$RELEASE_APP_ID_SOURCE" ]; then
      echo "Package mismatch: .github/workflows/release.yml does not read .package for release metadata"
      exit 1
    fi

    if [ "$APP_VERSION_CODE" != "$EXPECTED_VERSION_CODE" ]; then
      echo "VersionCode mismatch: app.json expo.android.versionCode=$APP_VERSION_CODE but expected $EXPECTED_VERSION_CODE from .version=$CANONICAL_VERSION"
      exit 1
    fi

    if [ "$GENERATED_VERSION" != "$CANONICAL_VERSION" ]; then
      echo "Version mismatch: .version=$CANONICAL_VERSION but src/constants/version.ts VERSION=$GENERATED_VERSION"
      exit 1
    fi

    for FILE in plugins/native-files/java/com/purple/coins/*.kt; do
      FILE_PACKAGE=$(grep -E '^package ' "$FILE" | head -1 | sed 's/^package //')
      if [ "$FILE_PACKAGE" != "$CANONICAL_PACKAGE" ]; then
        echo "Package mismatch: .package=$CANONICAL_PACKAGE but $FILE package=$FILE_PACKAGE"
        exit 1
      fi
    done

    CURRENT_VERSION="$CANONICAL_VERSION"
    CURRENT_PACKAGE="$CANONICAL_PACKAGE"
    VERSION="$CANONICAL_VERSION"
    APP_ID="$CANONICAL_PACKAGE"
}

run_apply() {
    CANONICAL_VERSION=$(cat .version)
    CANONICAL_PACKAGE=$(cat .package)
    VERSION_CODE=$(version_code_from_version "$CANONICAL_VERSION")

    write_json_file app.json "expo.version=$CANONICAL_VERSION
expo.android.package=$CANONICAL_PACKAGE
expo.android.versionCode=$VERSION_CODE"
    write_json_file package.json "version=$CANONICAL_VERSION"
  write_text_file src/constants/version.ts "const VERSION = \"$CANONICAL_VERSION\";

export default VERSION;"

    for FILE in plugins/native-files/java/com/purple/coins/*.kt; do
      replace_text_in_file "$FILE" '^package .*' "package $CANONICAL_PACKAGE"
    done

    CURRENT_VERSION="$CANONICAL_VERSION"
    CURRENT_PACKAGE="$CANONICAL_PACKAGE"
    VERSION="$CANONICAL_VERSION"
    APP_ID="$CANONICAL_PACKAGE"

    echo "Applied version $CANONICAL_VERSION"
    echo "Applied package $CANONICAL_PACKAGE"
    echo "Applied versionCode $VERSION_CODE"
}

run_build_core() {
  INSTALL_ON_DEVICE="$1"
  APK_SUFFIX="$2"

  LOG="logs/run_build.txt"
  : > "$LOG"

  validate_state

  echo "Recreating native Android project (clean prebuild)..."
  rm -rf android
  npx expo prebuild --clean --platform android > "$LOG" 2>&1

  if [ ! -f android/app/debug.keystore ]; then
    keytool -genkeypair -v \
      -storetype PKCS12 \
      -keystore android/app/debug.keystore \
      -storepass android \
      -keypass android \
      -alias androiddebugkey \
      -keyalg RSA -keysize 2048 -validity 10000 \
      -dname "CN=Android Debug,O=Android,C=US" >> "$LOG" 2>&1
  fi

  # Run gradle in background so the foreground can show a live timer.
  ( cd android && ./gradlew assembleRelease >> "../$LOG" 2>&1 ) &
  _GRADLE_PID=$!
  _BUILD_SECS=0
  while kill -0 "$_GRADLE_PID" 2>/dev/null; do
    printf "\rBuilding release APK... %ds" "$_BUILD_SECS"
    sleep 1
    _BUILD_SECS=$(( _BUILD_SECS + 1 ))
  done
  _BUILD_EXIT=0
  wait "$_GRADLE_PID" || _BUILD_EXIT=$?
  printf "\rBuilding release APK... done (%ds)\n" "$_BUILD_SECS"
  grep -E "prebuild|config plugin|plugins|Generating" "$LOG" | tail -n 20 || true
  grep -E "^BUILD |^FAILURE|^> Task :app:assemble" "$LOG" || true
  if [ "$_BUILD_EXIT" -ne 0 ]; then
    echo "Build failed. See $LOG for details."
    exit 1
  fi

  SRC="android/app/build/outputs/apk/release/app-release.apk"
  DEST="android/app/build/outputs/apk/release/${APP_ID}_${VERSION}_${APK_SUFFIX}.apk"

  mv "$SRC" "$DEST"

  echo ""
  echo "APK ready: $DEST"

  if [ "$INSTALL_ON_DEVICE" = "yes" ]; then
    # Install on any running AVD/device; skip silently if adb finds nothing.
    if adb devices | grep -q "device$"; then
      echo "Installing on device..."
      INSTALL_OUTPUT=$(adb install -r "$DEST" 2>&1) || _INSTALL_EXIT=$?
      _INSTALL_EXIT=${_INSTALL_EXIT:-0}
      echo "$INSTALL_OUTPUT"
      if [ "$_INSTALL_EXIT" -eq 0 ]; then
        echo "Installed successfully."
      elif echo "$INSTALL_OUTPUT" | grep -q "INSTALL_FAILED_VERSION_DOWNGRADE"; then
        echo "Downgrade detected. Reinstalling $APP_ID from scratch..."
        adb uninstall "$APP_ID" >/dev/null 2>&1 || true
        adb install "$DEST" && echo "Installed successfully after reinstall." || echo "Reinstall failed (check adb output above)."
      else
        echo "Install failed (check adb output above)."
      fi
    else
      echo "No AVD/device running. Start one and re-run."
      exit 1
    fi
  fi

  echo ""
  echo "Done in $(elapsed)s."
}

run_build() {
  run_build_core yes local
}

run_build_ci() {
  run_build_core no release
}

run_release() {
  LOG="logs/run_release.txt"
  : > "$LOG"

  validate_state

  if ! command -v gh >/dev/null 2>&1; then
    echo "GitHub CLI (gh) is required for release upload."
    exit 1
  fi

  if ! gh auth status >/dev/null 2>&1; then
    echo "GitHub CLI is not authenticated. Run: gh auth login"
    exit 1
  fi

  APK_PATH="android/app/build/outputs/apk/release/${APP_ID}_${VERSION}_release.apk"
  if [ ! -f "$APK_PATH" ]; then
    echo "Release APK not found at $APK_PATH"
    echo "Build it first using: ./run buildCi"
    exit 1
  fi

  BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
  SAFE_BRANCH=$(echo "$BRANCH_NAME" | tr '/' '-')
  TAG="v${VERSION}-${SAFE_BRANCH}"
  TITLE="v${VERSION} (${BRANCH_NAME})"
  NOTES="Automated Android build from branch ${BRANCH_NAME} (app version ${VERSION})."
  TARGET_SHA=$(git rev-parse HEAD)

  if gh release view "$TAG" >/dev/null 2>&1; then
    echo "Release $TAG already exists. Uploading/replacing APK asset..."
    gh release upload "$TAG" "$APK_PATH" --clobber > "$LOG" 2>&1
    gh release edit "$TAG" --latest >> "$LOG" 2>&1
  else
    echo "Creating release $TAG with APK asset..."
    gh release create "$TAG" "$APK_PATH" \
      --title "$TITLE" \
      --notes "$NOTES" \
      --target "$TARGET_SHA" \
      --latest > "$LOG" 2>&1
  fi

  echo "Release upload complete: $TAG"
  echo "Asset: $APK_PATH"
  echo ""
  echo "Done in $(elapsed)s."
}

run_test() {
  LOG="logs/run_test.txt"
  echo "Running unit tests with coverage..."
  bun run test:coverage > "$LOG" 2>&1; _UNIT_EXIT=$?
  grep -E "Test Files|^ *Tests |FAIL|PASS|error:" "$LOG" || true
  if [ "$_UNIT_EXIT" -eq 0 ]; then
    echo "Unit coverage tests passed."
  else
    echo "Unit coverage tests failed. See $LOG for details."
    exit 1
  fi

  echo ""
  echo "Done in $(elapsed)s."
}

run_e2e() {
  LOG="logs/run_e2e.txt"
  echo "Running end-to-end tests..."
  if bun run e2e > "$LOG" 2>&1; then
    _E2E_EXIT=0
  else
    _E2E_EXIT=$?
  fi
  grep -E "^(Flow|Error|FAILED|PASSED|Running)|FAIL|PASS|error:" "$LOG" || true
  if [ "$_E2E_EXIT" -eq 0 ]; then
    echo "E2E tests passed."
  else
    echo "E2E tests failed. See $LOG for details."
    exit 1
  fi

  echo ""
  echo "Done in $(elapsed)s."
}

run_lint() {
  LOG="logs/run_lint.txt"
  echo "Running sanity checks (format, lint, typecheck, tests)..."
  if bun run check > "$LOG" 2>&1; then
    _CHECK_EXIT=0
  else
    _CHECK_EXIT=$?
  fi
  grep -E "Checking formatting|All matched files|^\$ eslint|^\$ tsc|Test Files|^ *Tests |FAIL|PASS|error:" "$LOG" || true
  if [ "$_CHECK_EXIT" -eq 0 ]; then
    echo "Sanity checks passed."
  else
    echo "Sanity checks failed. See $LOG for details."
    exit 1
  fi

  echo ""
  echo "Done in $(elapsed)s."
}

run_format() {
  LOG="logs/run_format.txt"
  echo "Running formatter..."
  if bun run format > "$LOG" 2>&1; then
    _FORMAT_EXIT=0
  else
    _FORMAT_EXIT=$?
  fi
  grep -E "prettier|formatted|error:" "$LOG" || true
  if [ "$_FORMAT_EXIT" -eq 0 ]; then
    echo "Formatting completed."
  else
    echo "Formatting failed. See $LOG for details."
    exit 1
  fi

  echo ""
  echo "Done in $(elapsed)s."
}

run_flow() {
  PREFIX="$1"
  if [ -z "$PREFIX" ]; then
    echo "Usage: ./run flow <prefix>  e.g. ./run flow 15"
    exit 1
  fi
  MATCHES=$(find .maestro/flows -maxdepth 1 \( -name "${PREFIX}*.yaml" -o -name "${PREFIX}*.yml" \) ! -name "_*" | sort)
  COUNT=$(echo "$MATCHES" | grep -c "." 2>/dev/null || echo 0)
  if [ "$COUNT" -eq 0 ]; then
    echo "No flow found matching prefix '${PREFIX}'."
    exit 1
  fi
  if [ "$COUNT" -gt 1 ]; then
    echo "Multiple flows match prefix '${PREFIX}' — be more specific:"
    echo "$MATCHES"
    exit 1
  fi
  FLOW_FILE="$MATCHES"
  LOG="logs/run_flow_${PREFIX}.txt"
  echo "Running flow: $FLOW_FILE"
  _FLOW_EXIT=0
  maestro test --format junit -e APP_ID="$APP_ID" -e APP_VERSION="$VERSION" "$FLOW_FILE" > "$LOG" 2>&1 || _FLOW_EXIT=$?
  grep -E "^(Flow|Error|FAILED|PASSED|Running)" "$LOG" || true
  if [ "$_FLOW_EXIT" -eq 0 ]; then
    echo "Flow passed."
  else
    echo "Flow failed. See $LOG for details."
    exit 1
  fi
  echo ""
  echo "Done in $(elapsed)s."
}

print_usage() {
  echo "Usage: ./run <command> [command ...]"
  echo ""
  echo "Commands:"
  echo "  build         Recreate android via clean prebuild, then build a release APK"
  echo "  buildCi       CI build: recreate android + build APK, no device install"
  echo "  apply         Copy .version/.package into app.json/package.json/release.yml/kt files"
  echo "  format        Run formatter (bun run format)"
  echo "  lint          Run full sanity checks (format, lint, typecheck, tests)"
  echo "  test          Run unit tests with coverage"
  echo "  e2e           Run end-to-end tests (bun run e2e)"
  echo "  release       Upload release APK to GitHub Releases using gh CLI"
  echo "  flow <prefix> Run a single Maestro flow matching the given prefix"
  echo ""
  echo "Examples:"
  echo "  ./run build"
  echo "  ./run buildCi"
  echo "  ./run apply"
  echo "  ./run format"
  echo "  ./run lint"
  echo "  ./run test"
  echo "  ./run e2e"
  echo "  ./run release"
  echo "  ./run build test"
  echo "  ./run build flow 15"
}

if [ "$#" -eq 0 ]; then
  print_usage
  exit 1
fi

while [ "$#" -gt 0 ]; do
  COMMAND="$1"
  shift

  case "$COMMAND" in
    build)
      run_build
      ;;
    buildCi)
      run_build_ci
      ;;
    apply)
      run_apply
      ;;
    format)
      run_format
      ;;
    lint)
      run_lint
      ;;
    test)
      run_test
      ;;
    e2e)
      run_e2e
      ;;
    release)
      run_release
      ;;
    flow)
      PREFIX="${1:-}"
      if [ -z "$PREFIX" ]; then
        echo "Usage: ./run flow <prefix>  e.g. ./run flow 15"
        exit 1
      fi
      run_flow "$PREFIX"
      shift
      ;;
    *)
      echo "Unknown command: $COMMAND"
      print_usage
      exit 1
      ;;
  esac
done
