#!/bin/sh
set -eu

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -z "${ANDROID_HOME:-}" ]; then
  for CANDIDATE_SDK_DIR in \
    "$HOME/Library/Android/sdk" \
    "$HOME/Android/Sdk" \
    "${LOCALAPPDATA:-}/Android/Sdk"; do
    if [ -d "$CANDIDATE_SDK_DIR" ]; then
      export ANDROID_HOME="$CANDIDATE_SDK_DIR"
      break
    fi
  done
fi

version_code_from_version() {
  VERSION_INPUT="$1"
  node -e 'const raw=process.argv[1].trim(); const v=raw.startsWith("v") ? raw.slice(1) : raw; const parts=v.split("."); const invalid=()=>{ console.error("Invalid .version format. Use MAJOR.MINOR, MAJOR.MINOR.PATCH, or date style YYYY.MM.DD (YY.MM.DD also supported)."); process.exit(1); }; if (parts.length !== 2 && parts.length !== 3) invalid(); const nums=parts.map(Number); if (nums.some(Number.isNaN) || nums.some(p => p < 0)) invalid(); let code=0; if (parts.length === 2) { const [major, minor]=nums; if (major > 9999 || minor > 99) invalid(); code=(major*100)+(minor); } else { const [first, second, third]=nums; if (first > 9999 || second > 99 || third > 99) invalid(); const isYearStyle = first >= 1000; if (isYearStyle) { if (second < 1 || second > 12 || third < 1 || third > 31) invalid(); code=(first*10000)+(second*100)+third; } else { code=(first*10000)+(second*100)+third; } } if (!Number.isInteger(code) || code < 1 || code > 2147483647) { console.error(`Computed versionCode out of Android range: ${code}`); process.exit(1); } process.stdout.write(String(code));' "$VERSION_INPUT"
}

get_version() {
  tr -d '[:space:]' < .version
}

get_app_id() {
  node -e 'const fs=require("fs"); const json=JSON.parse(fs.readFileSync("app.json", "utf8")); process.stdout.write(String(json.expo.android.package));'
}

get_apk_path() {
  APP_ID=$(get_app_id)
  VERSION=$(get_version)
  echo "android/app/build/outputs/apk/release/${APP_ID}_${VERSION}.apk"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1"
    exit 1
  fi
}

validate_files_exist() {
  for file in .version app.json package.json; do
    if [ ! -f "$file" ]; then
      echo "Missing required file: $file"
      exit 1
    fi
  done
}

validate_state() {
  validate_files_exist

  FILE_VERSION=$(get_version)
  if [ -z "$FILE_VERSION" ]; then
    echo ".version is empty"
    exit 1
  fi

  EXPECTED_CODE=$(version_code_from_version "$FILE_VERSION")
  node -e 'const fs=require("fs"); const expectedVersion=process.argv[1]; const expectedCode=Number(process.argv[2]); const app=JSON.parse(fs.readFileSync("app.json", "utf8")); const pkg=JSON.parse(fs.readFileSync("package.json", "utf8")); if (app.expo.version !== expectedVersion) { console.error(`Version mismatch: .version=${expectedVersion} but app.json expo.version=${app.expo.version}`); process.exit(1); } if (pkg.version !== expectedVersion) { console.error(`Version mismatch: .version=${expectedVersion} but package.json version=${pkg.version}`); process.exit(1); } if (Number(app.expo.android.versionCode) !== expectedCode) { console.error(`VersionCode mismatch: app.json expo.android.versionCode=${app.expo.android.versionCode} but expected ${expectedCode}`); process.exit(1); }' "$FILE_VERSION" "$EXPECTED_CODE"
}

ensure_gradle_dist() {
  DIST_INFO=$(node -e 'const fs=require("fs"); const crypto=require("crypto"); const txt=fs.readFileSync("android/gradle/wrapper/gradle-wrapper.properties","utf8"); const m=txt.match(/^distributionUrl=(.*)$/m); if (!m) { console.error("distributionUrl not found in gradle-wrapper.properties"); process.exit(1); } const url=m[1].trim().replace(/\\:/g,":"); const base=url.split("/").pop(); if (!base || !base.endsWith(".zip")) { console.error(`Unexpected distributionUrl: ${url}`); process.exit(1); } const name=base.slice(0,-4); const hash=BigInt("0x"+crypto.createHash("md5").update(url).digest("hex")).toString(36); process.stdout.write(`${name} ${hash} ${url}`);')
  set -- $DIST_INFO
  DIST_NAME="$1"
  DIST_HASH="$2"
  DIST_URL="$3"
  DIST_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/$DIST_NAME/$DIST_HASH"

  if [ -f "$DIST_DIR/$DIST_NAME.zip.ok" ]; then
    echo "Gradle distribution already installed: $DIST_NAME"
    return
  fi

  echo "Downloading Gradle distribution with curl: $DIST_URL"
  TMP_ZIP=$(mktemp "${TMPDIR:-/tmp}/gradle-dist.XXXXXX")
  curl -fsSL --connect-timeout 15 -o "$TMP_ZIP" "$DIST_URL"

  EXPECTED_SHA=$(curl -fsSL --connect-timeout 15 "$DIST_URL.sha256" | tr -d '[:space:]')
  ACTUAL_SHA=$(shasum -a 256 "$TMP_ZIP" | awk '{print $1}')
  if [ "$EXPECTED_SHA" != "$ACTUAL_SHA" ]; then
    rm -f "$TMP_ZIP"
    echo "Gradle distribution checksum mismatch for $DIST_URL"
    echo "Expected: $EXPECTED_SHA"
    echo "Actual:   $ACTUAL_SHA"
    exit 1
  fi

  rm -rf "$DIST_DIR"
  mkdir -p "$DIST_DIR"
  unzip -q "$TMP_ZIP" -d "$DIST_DIR"
  touch "$DIST_DIR/$DIST_NAME.zip.ok"
  rm -f "$TMP_ZIP"
  echo "Gradle distribution installed: $DIST_NAME"
}

run_format() {
  for PROJECT_DIR in "$ROOT_DIR/app" "$ROOT_DIR/web"; do
    echo "Formatting $PROJECT_DIR..."
    (
      cd "$PROJECT_DIR"
      if command -v bun >/dev/null 2>&1; then
        bun run format
      else
        npm run format
      fi
    )
  done
}

run_setup() {
  for PROJECT_DIR in "$ROOT_DIR/app" "$ROOT_DIR/web"; do
    echo "Installing dependencies in $PROJECT_DIR..."
    (
      cd "$PROJECT_DIR"
      if command -v bun >/dev/null 2>&1; then
        bun install
      else
        npm install
      fi
    )
  done
}

run_test() {
  if command -v bun >/dev/null 2>&1; then
    bun run typecheck
    bun run test --coverage
  else
    npm run typecheck
    npm run test -- --coverage
  fi
}

run_apply() {
  validate_files_exist

  FILE_VERSION=$(get_version)
  VERSION_CODE=$(version_code_from_version "$FILE_VERSION")

  node -e 'const fs=require("fs"); const v=process.argv[1]; const vc=Number(process.argv[2]); const app=JSON.parse(fs.readFileSync("app.json", "utf8")); const pkg=JSON.parse(fs.readFileSync("package.json", "utf8")); app.expo.version=v; app.expo.android.versionCode=vc; pkg.version=v; fs.writeFileSync("app.json", JSON.stringify(app, null, "\t") + "\n"); fs.writeFileSync("package.json", JSON.stringify(pkg, null, "\t") + "\n");' "$FILE_VERSION" "$VERSION_CODE"

  echo "Applied version: $FILE_VERSION"
  echo "Applied versionCode: $VERSION_CODE"
}

run_build() {
  mkdir -p logs
  LOG="logs/run_build.txt"
  : > "$LOG"

  validate_state

  echo "Recreating native Android project (clean prebuild)..."
  rm -rf android
  npx expo prebuild --clean --platform android >> "$LOG" 2>&1

  ensure_gradle_dist

  if [ ! -f android/app/debug.keystore ]; then
    keytool -genkeypair -v \
      -storetype PKCS12 \
      -keystore android/app/debug.keystore \
      -storepass android \
      -keypass android \
      -alias androiddebugkey \
      -keyalg RSA -keysize 2048 -validity 10000 \
      -dname "CN=Android Debug,O=Android,C=US" >> "$LOG" 2>&1
  fi

  (
    cd android
    ./gradlew assembleRelease --parallel --build-cache \
      -Pexpo.useLegacyPackaging=true \
      -Pandroid.enableMinifyInReleaseBuilds=true \
      -Pandroid.enableShrinkResourcesInReleaseBuilds=true >> "../$LOG" 2>&1
  )

  APP_ID=$(get_app_id)
  VERSION=$(get_version)
  SRC="android/app/build/outputs/apk/release/app-release.apk"
  DEST="android/app/build/outputs/apk/release/${APP_ID}_${VERSION}.apk"

  if [ ! -f "$SRC" ]; then
    echo "Release APK not found at $SRC"
    exit 1
  fi

  mv "$SRC" "$DEST"
  echo "APK ready: $DEST"
}

run_install() {
  require_cmd adb
  validate_state

  APP_ID=$(get_app_id)
  APK_PATH=$(get_apk_path)

  if [ ! -f "$APK_PATH" ]; then
    echo "APK not found at $APK_PATH"
    echo "Run ./run build first."
    exit 1
  fi

  if ! adb devices | grep -q "device$"; then
    echo "No AVD/device running. Start one and rerun."
    exit 1
  fi

  echo "Uninstalling existing app ($APP_ID) if present..."
  adb uninstall "$APP_ID" >/dev/null 2>&1 || true

  echo "Installing on local AVD/device..."
  INSTALL_OUTPUT=$(adb install "$APK_PATH" 2>&1) || INSTALL_EXIT=$?
  INSTALL_EXIT=${INSTALL_EXIT:-0}
  echo "$INSTALL_OUTPUT"

  if [ "$INSTALL_EXIT" -eq 0 ]; then
    echo "Installed successfully."
    return
  fi

  echo "Install failed."
  exit 1
}

run_avd() {
  require_cmd adb
  require_cmd emulator

  CLEAN=false
  if [ "${2:-}" = "--clean" ]; then
    CLEAN=true
  elif [ -n "${2:-}" ]; then
    echo "Unknown avd option: ${2}"
    echo "Usage: ./run avd [--clean]"
    exit 1
  fi

  RUNNING_DEVICE=$(adb devices | awk '$1 ~ /^emulator-/ && $2 == "device" { print $1; exit }')
  if [ -n "$RUNNING_DEVICE" ]; then
    if [ "$CLEAN" = true ]; then
      echo "Stopping AVD: $RUNNING_DEVICE"
      adb -s "$RUNNING_DEVICE" emu kill >/dev/null
    else
      echo "AVD already running: $RUNNING_DEVICE"
      return
    fi
  fi

  AVD=$(emulator -list-avds | sed -n '1p')
  if [ -z "$AVD" ]; then
    echo "No Android Virtual Devices found. Create one in Android Studio first."
    exit 1
  fi

  if [ "$CLEAN" = true ]; then
    echo "Starting clean AVD: $AVD"
    emulator -avd "$AVD" -wipe-data >/tmp/purplecoins-avd.log 2>&1 &
  else
    echo "Starting AVD: $AVD"
    emulator -avd "$AVD" >/tmp/purplecoins-avd.log 2>&1 &
  fi

  adb wait-for-device
  echo "AVD ready: $AVD"
}

run_release() {
  require_cmd gh
  validate_state

  if ! gh auth status >/dev/null 2>&1; then
    echo "GitHub CLI is not authenticated. Run: gh auth login"
    exit 1
  fi

  VERSION=$(get_version)
  TAG="v${VERSION}"
  APK_PATH=$(get_apk_path)

  if [ ! -f "$APK_PATH" ]; then
    echo "APK not found at $APK_PATH"
    echo "Run ./run build first."
    exit 1
  fi

  if ! git rev-parse "$TAG" >/dev/null 2>&1; then
    git tag "$TAG"
    git push origin "$TAG"
  fi

  if gh release view "$TAG" >/dev/null 2>&1; then
    gh release upload "$TAG" "$APK_PATH" --clobber
    gh release edit "$TAG" --title "$TAG" --draft=false
  else
    gh release create "$TAG" "$APK_PATH" --title "$TAG" --notes "Release $TAG"
  fi

  echo "Release published: $TAG"
}

show_help() {
  cat <<'HELP'
Usage: ./run <command>

Commands:
  format   Run prettier in app and web
  setup    Install dependencies in app and web
  test     Run typecheck, then unit tests with coverage (app)
  apply    Apply .version to app.json and package.json, and compute versionCode
  build    Clean prebuild Android and assemble release APK with Gradle
  avd      Start the first configured Android Virtual Device
  install  Install existing APK on local AVD/device
  release  Create tag v{version} and publish GitHub release v{version} with existing APK
HELP
}

case "${1:-}" in
  format)
    run_format
    ;;
  setup)
    run_setup
    ;;
  test)
    cd "$ROOT_DIR/app"
    run_test
    ;;
  apply)
    cd "$ROOT_DIR/app"
    run_apply
    ;;
  build)
    cd "$ROOT_DIR/app"
    run_build
    ;;
  avd)
    cd "$ROOT_DIR/app"
    run_avd "$@"
    ;;
  install)
    cd "$ROOT_DIR/app"
    run_install
    ;;
  release)
    cd "$ROOT_DIR/app"
    run_release
    ;;
  *)
    show_help
    exit 1
    ;;
esac
