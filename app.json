{
	"expo": {
		"name": "Purplecoins",
		"slug": "purplecoins_2026_experimental",
		"version": "5.6.1",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "dark",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/icon.png",
				"backgroundColor": "#080B14"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.purple.coins.experimental"
		},
		"web": {
			"favicon": "./assets/icon.png"
		},
		"plugins": [
			"expo-sqlite",
			"expo-notifications",
			"expo-sharing",
			"@react-native-community/datetimepicker",
			"expo-font",
			"expo-splash-screen",
			"./plugins/withUpiNotificationDetector",
			[
				"@react-native-voice/voice",
				{
					"microphonePermission": "Allow Purplecoins to access your microphone for voice quick-add.",
					"speechRecognitionPermission": "Allow Purplecoins to recognize speech for voice quick-add."
				}
			],
			[
				"expo-quick-actions",
				{
					"androidIcons": {
						"shortcut_add": {
							"foregroundImage": "./assets/icon.png",
							"backgroundColor": "#7B52AB"
						}
					},
					"iosActions": [
						{
							"id": "add-expense",
							"title": "Add Expense",
							"icon": "add",
							"params": {
								"prefillType": "DEBIT"
							}
						},
						{
							"id": "add-income",
							"title": "Add Income",
							"icon": "add",
							"params": {
								"prefillType": "CREDIT"
							}
						}
					]
				}
			]
		]
	}
}
